rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Deny all reads, writes, and deletes by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Only allow mutations from the authorized Delish server
    function isServerAuthorized(data) {
      return data.serverSign is string && data.serverSign == 'DELISH_AUTHORIZED_SERVER_2026';
    }

    function isValidOrder(data) {
      return isServerAuthorized(data)
        && data.orderType is string && (data.orderType == 'dine_in' || data.orderType == 'delivery')
        && data.total is number && data.total >= 0
        && data.status is string && (data.status == 'Received' || data.status == 'Preparing' || data.status == 'Ready' || data.status == 'Completed' || data.status == 'Cancelled' || data.status == 'Expired')
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    function isValidReservation(data) {
      return isServerAuthorized(data)
        && data.date is string && data.date.size() <= 50
        && data.time is string && data.time.size() <= 50
        && data.table is string && data.table.size() <= 50
        && data.guests is number && data.guests > 0
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 50
        && data.status is string && (data.status == 'confirmed' || data.status == 'cancelled' || data.status == 'seated' || data.status == 'checked_in' || data.status == 'no_show')
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    function isValidSession(data) {
      return isServerAuthorized(data)
        && data.sessionId is string && data.sessionId.size() <= 128
        && data.tableId is string && data.tableId.size() <= 50
        && data.status is string && (data.status == 'active' || data.status == 'closed')
        && data.startedAt is string && data.startedAt.size() <= 100;
    }

    function isValidTable(data) {
      return isServerAuthorized(data)
        && data.tableNumber is string && data.tableNumber.size() <= 50
        && data.status is string && (data.status == 'available' || data.status == 'occupied')
        && data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    // 2. Orders: NO PUBLIC ENUMERATION OR DIRECT READS.
    // Protects customer names, phones, addresses, and order details.
    match /orders/{orderId} {
      allow list: if false;
      allow get: if false;
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow update: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow delete: if false;
    }

    // 3. Reservations: NO PUBLIC ENUMERATION OR DIRECT READS.
    // Protects customer phone numbers and booking details.
    match /reservations/{reservationId} {
      allow list: if false;
      allow get: if false;
      allow create: if isValidId(reservationId) && isValidReservation(request.resource.data);
      allow update: if isValidId(reservationId) && isValidReservation(request.resource.data);
      allow delete: if false;
    }

    // 4. Dining Sessions: No enumeration
    match /sessions/{sessionId} {
      allow list: if false;
      allow get: if isServerAuthorized(resource.data);
      allow create: if isValidId(sessionId) && isValidSession(request.resource.data);
      allow update: if isValidId(sessionId) && isValidSession(request.resource.data);
      allow delete: if false;
    }

    // 5. Tables: Public read allows customers to see Table 1..10 occupancy in the cafe menu
    match /tables/{tableId} {
      allow read: if true;
      allow create: if isValidId(tableId) && isValidTable(request.resource.data);
      allow update: if isValidId(tableId) && isValidTable(request.resource.data);
      allow delete: if false;
    }
  }
}
