rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Common helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Order validation helper
    function isValidOrder(data) {
      return data.orderType is string && (data.orderType == 'dine_in' || data.orderType == 'delivery')
        && data.total is number && data.total >= 0
        && data.status is string && (data.status == 'Received' || data.status == 'Preparing' || data.status == 'Ready' || data.status == 'Completed')
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    // Reservation validation helper
    function isValidReservation(data) {
      return data.date is string && data.date.size() <= 50
        && data.time is string && data.time.size() <= 50
        && data.table is string && data.table.size() <= 50
        && data.guests is number && data.guests > 0
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 50
        && data.status is string && (data.status == 'confirmed' || data.status == 'cancelled')
        && data.createdAt is string && data.createdAt.size() <= 100;
    }

    // Session validation helper
    function isValidSession(data) {
      return data.sessionId is string && data.sessionId.size() <= 128
        && data.tableId is string && data.tableId.size() <= 50
        && data.status is string && (data.status == 'active' || data.status == 'closed')
        && data.startedAt is string && data.startedAt.size() <= 100;
    }

    // Table validation helper
    function isValidTable(data) {
      return data.tableNumber is string && data.tableNumber.size() <= 50
        && data.status is string && (data.status == 'available' || data.status == 'occupied')
        && data.updatedAt is string && data.updatedAt.size() <= 100;
    }

    // 2. Orders Rules
    match /orders/{orderId} {
      allow read: if true;
      allow create: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow update: if isValidId(orderId) && isValidOrder(request.resource.data);
      allow delete: if false;
    }

    // 3. Reservations Rules
    match /reservations/{reservationId} {
      allow read: if true;
      allow create: if isValidId(reservationId) && isValidReservation(request.resource.data);
      allow update: if isValidId(reservationId) && isValidReservation(request.resource.data);
      allow delete: if false;
    }

    // 4. Dining Sessions Rules
    match /sessions/{sessionId} {
      allow read: if true;
      allow create: if isValidId(sessionId) && isValidSession(request.resource.data);
      allow update: if isValidId(sessionId) && isValidSession(request.resource.data);
      allow delete: if false;
    }

    // 5. Tables Rules
    match /tables/{tableId} {
      allow read: if true;
      allow create: if isValidId(tableId) && isValidTable(request.resource.data);
      allow update: if isValidId(tableId) && isValidTable(request.resource.data);
      allow delete: if false;
    }
  }
}
