{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "An order placed by a customer",
      "type": "object",
      "properties": {
        "tableNumber": {
          "type": "string",
          "description": "Table number or 'Delivery'"
        },
        "orderType": {
          "type": "string",
          "enum": ["dine_in", "delivery"],
          "description": "The type of order"
        },
        "deliveryAddress": {
          "type": "string",
          "description": "Delivery address"
        },
        "items": {
          "type": "array",
          "description": "Ordered items"
        },
        "total": {
          "type": "number",
          "description": "Total order amount"
        },
        "status": {
          "type": "string",
          "enum": ["Received", "Preparing", "Ready", "Completed", "Cancelled", "Expired"],
          "description": "Order processing status"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation timestamp"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["unpaid", "pending", "paid", "failed", "refunded"],
          "description": "Payment settlement status"
        },
        "paymentMethod": {
          "type": "string",
          "description": "Method used for payment"
        },
        "paymentId": {
          "type": "string",
          "description": "Transaction/payment reference ID"
        },
        "sessionId": {
          "type": "string",
          "description": "Customer session identifier for multi-user privacy isolation"
        }
      },
      "required": ["orderType", "items", "total", "status", "createdAt"]
    },
    "Reservation": {
      "title": "Reservation",
      "description": "A table reservation",
      "type": "object",
      "properties": {
        "date": {
          "type": "string",
          "description": "Date of reservation"
        },
        "time": {
          "type": "string",
          "description": "Time slot of reservation"
        },
        "table": {
          "type": "string",
          "description": "Table number assigned"
        },
        "guests": {
          "type": "number",
          "description": "Number of guests"
        },
        "name": {
          "type": "string",
          "description": "Customer name"
        },
        "phone": {
          "type": "string",
          "description": "Customer phone number"
        },
        "status": {
          "type": "string",
          "enum": ["confirmed", "cancelled", "seated", "checked_in", "no_show"],
          "description": "Reservation status"
        },
        "createdAt": {
          "type": "string",
          "description": "Reservation booking time"
        },
        "sessionId": {
          "type": "string",
          "description": "Customer session identifier for multi-user privacy isolation"
        }
      },
      "required": ["date", "time", "table", "guests", "name", "phone", "status", "createdAt"]
    },
    "Table": {
      "title": "Table",
      "description": "A cafe dining table with its active session pointer",
      "type": "object",
      "properties": {
        "tableNumber": {
          "type": "string",
          "description": "Table number identifier"
        },
        "status": {
          "type": "string",
          "enum": ["available", "occupied"],
          "description": "Table occupancy state"
        },
        "activeSessionId": {
          "type": "string",
          "description": "ID of current active dining session or empty"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last updated timestamp"
        }
      },
      "required": ["tableNumber", "status", "updatedAt"]
    },
    "Session": {
      "title": "Session",
      "description": "A dining session for a table encompassing multiple orders",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "description": "Unique session identifier"
        },
        "tableId": {
          "type": "string",
          "description": "Assigned table number"
        },
        "status": {
          "type": "string",
          "enum": ["active", "closed"],
          "description": "Session lifecycle state"
        },
        "billStatus": {
          "type": "string",
          "enum": ["open", "requested", "paid"],
          "description": "Session final bill status"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["unpaid", "pending", "paid", "failed"],
          "description": "Session payment status"
        },
        "startedAt": {
          "type": "string",
          "description": "Timestamp when session began"
        },
        "closedAt": {
          "type": "string",
          "description": "Timestamp when session was finalized and table freed"
        },
        "total": {
          "type": "number",
          "description": "Cumulative total of all orders in this session"
        },
        "orderIds": {
          "type": "array",
          "description": "List of order IDs placed during this visit"
        }
      },
      "required": ["sessionId", "tableId", "status", "startedAt"]
    }
  },
  "firestore": {
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of all restaurant orders"
    },
    "reservations/{reservationId}": {
      "schema": "Reservation",
      "description": "Collection of table reservations"
    },
    "tables/{tableId}": {
      "schema": "Table",
      "description": "Collection of cafe dining tables and their active session references"
    },
    "sessions/{sessionId}": {
      "schema": "Session",
      "description": "Collection of dining sessions per table"
    }
  }
}
